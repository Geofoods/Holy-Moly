dialogue_text = "Welcome to Mole Village! The tunnels go deeper than you think. Stay sharp out there."
npc_name = "Duggy"

[node name="NpcMole2" parent="." unique_id=2043288762 instance=ExtResource("14_3j6u0")]
modulate = Color(0.49, 0.643, 1, 1)
position = Vector2(719, -58)
scale = Vector2(0.25, 0.25)
dialogue_text = "I once saw a grub as long as my paw. It got away... but I still dream about it."
npc_name = "Scoop"

[node name="NpcMole3" parent="." unique_id=1344418850 instance=ExtResource("14_3j6u0")]
modulate = Color(0.4108, 0.79, 0.61304003, 1)
position = Vector2(3435, -145)
scale = Vector2(0.25, 0.25)
dialogue_text = "If you're heading down, remember: the honeycombs might just save your skin."
